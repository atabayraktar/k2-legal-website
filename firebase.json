{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/hakkimizda",
        "destination": "/#hakkimizda",
        "type": 301
      },
      {
        "source": "/hakkimizda/",
        "destination": "/#hakkimizda",
        "type": 301
      },
      {
        "source": "/ekibimiz",
        "destination": "/#ekibimiz",
        "type": 301
      },
      {
        "source": "/ekibimiz/",
        "destination": "/#ekibimiz",
        "type": 301
      },
      {
        "source": "/iletisim",
        "destination": "/#iletisim",
        "type": 301
      },
      {
        "source": "/iletisim/",
        "destination": "/#iletisim",
        "type": 301
      },
      {
        "source": "/calisma-alanlari",
        "destination": "/#calisma-alanlari",
        "type": 301
      },
      {
        "source": "/calisma-alanlari/",
        "destination": "/#calisma-alanlari",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(images|logos|og)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/@(favicon.svg|favicon-32.png|apple-touch-icon.png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/@(sitemap.xml|robots.txt|llms.txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
