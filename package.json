{
  "name": "k2-legal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "assets": "node scripts/build-assets.mjs",
    "prebuild": "node scripts/generate-seo.mjs && node scripts/check-copy.mjs && node scripts/check-placeholders.mjs",
    "build": "next build",
    "start:static": "node .claude/serve.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs --strict",
    "check:copy": "node scripts/check-copy.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "logos": "node scripts/build-logos.mjs",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "puppeteer-core": "^24.43.1",
    "sass": "^1.105.0",
    "sharp": "^0.35.5"
  }
}
